+    def _safe_raxml_table_build(self, group): # kapurlab: isolate per-group tree/table build
+        # A failure building one group's tree/table (RAxML, BioPython, pandas)
+        # must never abort the whole run — pool.map re-raises the first worker
+        # exception, which would kill every other group's results. Flag the bad
+        # group (BUILD_ERROR) and carry on; the rest, incl. all_vcf, still finish.
+        try:
+            return self.raxml_table_build(group)
+        except Exception as tree_err:
+            print(f'\n\t##### tree/table build failed for group {group}: {type(tree_err).__name__}: {tree_err}\n')
+            try:
+                os.makedirs(group, exist_ok=True)
+                with open(f'{group}/BUILD_ERROR', 'w') as message_out:
+                    print(f'{type(tree_err).__name__}: {tree_err}', file=message_out)
+            except OSError:
+                pass
+            return None
