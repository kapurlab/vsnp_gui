#!/usr/bin/env bash
# vSNP GUI (dev) OOD batch_connect script.
# $port (uvicorn) and $worktree_dir are exported by before.sh.erb.

echo "=== vSNP GUI (dev) Session Starting ==="
echo "uvicorn:${port}"
echo "worktree:${worktree_dir}"

# Shared lab tools (T-11). Falls back to per-user install if the shared one
# is not present.
SHARED_VSNP3=/srv/kapurlab/tools/vsnp3
PERSONAL_VSNP3=/home/${USER}/miniforge3/envs/vsnp3
PERSONAL_BASE_PYTHON=/home/${USER}/miniforge3/bin/python
if [ -d "${SHARED_VSNP3}" ]; then
  VSNP3_ENV="${SHARED_VSNP3}"
  PYTHON="${SHARED_VSNP3}/bin/python"
else
  VSNP3_ENV="${PERSONAL_VSNP3}"
  PYTHON="${PERSONAL_BASE_PYTHON}"
fi

# Dev override: prefer the per-session worktree if before.sh.erb set one.
SHARED_VSNP_GUI=/srv/kapurlab/tools/vsnp_gui
PERSONAL_VSNP_GUI=/home/${USER}/vsnp_gui
if [ -n "${worktree_dir}" ] && [ -d "${worktree_dir}/backend" ]; then
  VSNP_DIR="${worktree_dir}"
elif [ -d "${SHARED_VSNP_GUI}/backend" ]; then
  VSNP_DIR="${SHARED_VSNP_GUI}"
else
  VSNP_DIR="${PERSONAL_VSNP_GUI}"
fi

# Make vsnp3 env CLI tools available.
export PATH="${VSNP3_ENV}/bin:${PATH}"

# Dev: build the frontend from the selected branch's source so UI changes are
# served. Only runs in the per-session worktree (never the shared install).
# The worktree's node_modules is gitignored/absent, so reuse the shared
# install's via a symlink to keep `vite build` fast (~5s). Falls back to any
# existing dist/ if the build fails (e.g. a branch that changed deps — then a
# real `npm install` would be needed in the worktree).
if [ -n "${worktree_dir}" ] && [ "${VSNP_DIR}" = "${worktree_dir}" ] && [ -d "${VSNP_DIR}/frontend" ]; then
  if [ ! -e "${VSNP_DIR}/frontend/node_modules" ] && [ -d "${SHARED_VSNP_GUI}/frontend/node_modules" ]; then
    ln -s "${SHARED_VSNP_GUI}/frontend/node_modules" "${VSNP_DIR}/frontend/node_modules"
  fi
  echo "Building frontend (vite) from worktree source…"
  ( cd "${VSNP_DIR}/frontend" && npm run build ) \
    || echo "WARN: frontend build failed; serving existing dist/ if present."
fi

cd "${VSNP_DIR}/backend"
echo "Starting uvicorn on port ${port}"
echo "  vsnp3 env: ${VSNP3_ENV}"
echo "  vsnp_gui:  ${VSNP_DIR}"
exec $PYTHON -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port "${port}" \
    --log-level info \
    --reload \
    --reload-dir app
