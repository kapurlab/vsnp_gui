# Python
__pycache__/
*.pyc
*.pyo
**/.venv/

# Node / frontend
node_modules/
dist/
.vite/
electron/node_modules/

# Env / local config
.env
.env.*
!.env.example

# OS / logs
.DS_Store
*.log

# Office app lock files (Word / Excel / PowerPoint create these while
# a document is open; they're not source and shouldn't ever be tracked).
~$*

# Local icon drafts
assets/icons/*_draft.*
assets/icons/*_drafts/*
assets/icons/*_temp.*

# App bundle / icon assets
vSNP.app/
vSNP.icns
Gemini_Generated_Image_*.png

# App data
backend/data/
backend/projects/
